{
    "name": "lubomedia/lokal-v13",
    "description": "Lokale TYPO3-13.4-Instanz zum Testen der Erweiterung",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "repositories": [
        { "type": "path", "url": "/ext", "options": { "symlink": true } }
    ],
    "require": {
        "typo3/cms-backend": "^13.4",
        "typo3/cms-core": "^13.4",
        "typo3/cms-extbase": "^13.4",
        "typo3/cms-fluid": "^13.4",
        "typo3/cms-fluid-styled-content": "^13.4",
        "typo3/cms-frontend": "^13.4",
        "typo3/cms-install": "^13.4",
        "typo3/cms-scheduler": "^13.4",
        "typo3/cms-setup": "^13.4",
        "typo3/cms-filelist": "^13.4",
        "typo3/cms-seo": "^13.4",
        "bk2k/bootstrap-package": "*",
        "lubomedia/barrierepruefung-typo3": "@dev"
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
