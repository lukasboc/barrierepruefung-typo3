{
    "name": "lubomedia/lokal-v14",
    "description": "Lokale TYPO3-14.3-Instanz zum Testen der Erweiterung",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "repositories": [
        { "type": "path", "url": "/ext", "options": { "symlink": true } }
    ],
    "require": {
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-extbase": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-fluid-styled-content": "^14.3",
        "typo3/cms-frontend": "^14.3",
        "typo3/cms-impexp": "^14.3",
        "typo3/cms-install": "^14.3",
        "typo3/cms-scheduler": "^14.3",
        "typo3/cms-setup": "^14.3",
        "typo3/cms-filelist": "^14.3",
        "typo3/cms-seo": "^14.3",
        "typo3/theme-camino": "*",
        "lubomedia/barrierepruefung-typo3": "@dev"
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
