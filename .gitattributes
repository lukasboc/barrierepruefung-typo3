# Aus dem Tag-Archiv bleibt heraus, was nur der Entwicklung dient. Packagist (Composer) bekommt dieses Archiv.
# Das TER-Archiv entsteht aus demselben `git archive` (release.yml), Tailor packt es aber mit seiner eigenen
# Ausschlussliste neu: Tests/ fällt dort ganz weg, also auch Tests/Fixtures/fragment/ (das TER-Archiv ist daher
# etwas kleiner als das von Packagist; der Gleichlauf-Test im Dienst liest die Fixtures aus Packagist).
/.github export-ignore
/Build export-ignore
/.php-cs-fixer.dist.php export-ignore
/phpstan.neon.dist export-ignore
/CLAUDE.md export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore

# Tests/ steht nicht als Ganzes hier: Tests/Fixtures/fragment/ muss im Archiv bleiben,
# weil der Gleichlauf-Test im Dienst die Fixtures aus dem Composer-Archiv (Packagist) liest. Git kann ein
# Unterverzeichnis eines export-ignore-Verzeichnisses nicht wieder einschließen,
# deshalb werden die übrigen Verzeichnisse einzeln ausgenommen.
/Tests/Unit export-ignore
/Tests/Functional export-ignore
